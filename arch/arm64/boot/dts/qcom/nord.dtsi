	soc: soc@0 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges = <0 0 0 0 0x10 0>;

		qupv3_id_2: geniqup@8c0000 {
			compatible = "qcom,nord-auto-geni-se-qup","qcom,sa8255p-geni-se-qup";
			reg = <0x0 0x8c0000 0x0 0x2000>;
			#address-cells = <2>;
			#size-cells = <2>;
			iommus = <&apps_smmu_0 0x15a3 0x0>;
			ranges;

			uart15: serial@884000 {
				compatible = "qcom,nord-auto-geni-debug-uart","qcom,sa8255p-geni-debug-uart";
				reg = <0x0 0x884000 0x0 0x4000>;
				interrupts = <GIC_SPI 583 IRQ_TYPE_LEVEL_HIGH>;
				power-domains = <&scmi11_pd 15>, <&scmi11_dvfs 15>;
				power-domain-names = "power", "perf";
				status = "disabled";
			};

			uart17: serial@88c000 {
				compatible = "qcom,nord-auto-geni-uart","qcom,sa8255p-geni-uart";
				reg = <0x0 0x88c000 0x0 0x4000>;
				interrupts = <GIC_SPI 585 IRQ_TYPE_LEVEL_HIGH>;
				power-domains = <&scmi11_pd 17>, <&scmi11_dvfs 17>;
				power-domain-names = "power", "perf";
				qcom,wakeup-byte = <0xfd>;
				status = "disabled";
			};
		};

		qupv3_id_0: geniqup@9c0000 {
			compatible = "qcom,nord-auto-geni-se-qup","qcom,sa8255p-geni-se-qup";
			reg = <0x0 0x9c0000 0x0 0x2000>;
			#address-cells = <2>;
			#size-cells = <2>;
			iommus = <&apps_smmu_2 0x1003 0x0>;
			ranges;

			uart3: serial@98c000 {
				compatible = "qcom,nord-auto-geni-uart","qcom,sa8255p-geni-uart";
				reg = <0x0 0x98c000 0x0 0x4000>;
				interrupts = <GIC_SPI 515 IRQ_TYPE_LEVEL_HIGH>;
				power-domains = <&scmi11_pd 3>, <&scmi11_dvfs 3>;
				power-domain-names = "power", "perf";
				qcom,wakeup-byte = <0xfd>;
				status = "disabled";
			};

			uart0: serial@980000 {
				compatible = "qcom,nord-auto-geni-uart","qcom,sa8255p-geni-uart";
				reg = <0x0 0x980000 0x0 0x4000>;
				interrupts = <GIC_SPI 314 IRQ_TYPE_LEVEL_HIGH>;
				power-domains = <&scmi11_pd 0>, <&scmi11_dvfs 0>;
				power-domain-names = "power", "perf";
				status = "disabled";
			};

			uart4: serial@990000 {
				compatible = "qcom,nord-auto-geni-uart","qcom,sa8255p-geni-uart";
				reg = <0x0 0x990000 0x0 0x4000>;
				interrupts = <GIC_SPI 516 IRQ_TYPE_LEVEL_HIGH>;
				power-domains = <&scmi11_pd 4>, <&scmi11_dvfs 4>;
				power-domain-names = "power", "perf";
				status = "disabled";
			};

			uart5: serial@994000 {
				compatible = "qcom,nord-auto-geni-uart","qcom,sa8255p-geni-uart";
				reg = <0x0 0x994000 0x0 0x4000>;
				interrupts = <GIC_SPI 517 IRQ_TYPE_LEVEL_HIGH>;
				power-domains = <&scmi11_pd 5>, <&scmi11_dvfs 5>;
				power-domain-names = "power", "perf";
				status = "disabled";
			};
		};

		qupv3_id_1: geniqup@ac0000 {
			compatible = "qcom,nord-auto-geni-se-qup","qcom,sa8255p-geni-se-qup";
			reg = <0x0 0xac0000 0x0 0x2000>;
			#address-cells = <2>;
			#size-cells = <2>;
			iommus = <&apps_smmu_2 0x1043 0x0>;
			ranges;

			uart9: serial@a88000 {
				compatible = "qcom,nord-auto-geni-uart","qcom,sa8255p-geni-uart";
				reg = <0x0 0xa88000 0x0 0x4000>;
				interrupts = <GIC_SPI 355 IRQ_TYPE_LEVEL_HIGH>;
				power-domains = <&scmi11_pd 9>, <&scmi11_dvfs 9>;
